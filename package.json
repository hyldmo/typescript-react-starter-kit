{
  "name": "typescript-react-starter-kit",
  "repository": "https://github.com/hyldmo/typescript-react-starter-kit",
  "version": "1.3.0",
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "VITE_BASE=/typescript-react-starter-kit/ vite build && node scripts/copy-404.mjs",
    "preview": "vite preview",
    "preview:worker": "wrangler dev --config workers/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config workers/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn lint && yarn typecheck && yarn test"
  },
  "keywords": [
    "Typescript",
    "React",
    "Redux",
    "Redux Saga",
    "Tailwind"
  ],
  "license": "MIT",
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router": "^7.15.0",
    "react-router-dom": "^7.15.0",
    "redux-saga": "^1.3.0",
    "tailwind-merge": "^3.4.0",
    "typed-redux-saga": "^1.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@cloudflare/workers-types": "^4.20250911.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.87.0"
  }
}
